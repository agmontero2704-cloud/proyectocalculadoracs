<?xml version="1.0" encoding="utf-8"?>
<!--
  Calculadora de áreas - Web Forms .NET Framework 4.8
  Web.config mínimo: sin dependencias NuGet (Optimization, FriendlyUrls, etc.)
  porque el proyecto no las usa y no están en la carpeta packages/.
-->
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="WebForm2.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
